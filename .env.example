# Optional: Zaptec usernames (emails) that may log in, comma separated.
# Empty = anyone with a Zaptec account. Fiken access is controlled by the
# Fiken app's "Godkjente brukere" list, since each user connects their own Fiken.
ALLOWED_USERS=

# Encrypts the stored Fiken tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it disconnects everyone from Fiken (they must connect again).
SECRET_KEY=

# Fiken OAuth app (Rediger konto -> API -> Ny app, "Meg selv/mine foretak").
# The redirect URI must be registered on the app exactly as written here.
FIKEN_CLIENT_ID=
FIKEN_CLIENT_SECRET=
FIKEN_REDIRECT_URI=https://faktura.example.no/fiken/callback

# Invoice line settings. Prefer a Fiken product, which carries VAT type and
# income account; otherwise the VAT type and income account below are used.
FIKEN_PRODUCT_ID=
FIKEN_VAT_TYPE=HIGH
FIKEN_INCOME_ACCOUNT=3000
FIKEN_DAYS_UNTIL_DUE=14

# Set to false only for local development over plain http in browsers
# that refuse Secure cookies on localhost.
COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=43200

# Defaults to data/zaptecfaktura.db locally and /data/zaptecfaktura.db in Docker.
# DATABASE_PATH=
