# Zaptec usernames (emails) that may log in, comma separated.
# Required when Fiken is configured; otherwise every login is refused.
ALLOWED_USERS=

# Fiken: personal API token (Rediger konto -> API -> Personlige API-nøkler)
# and the company slug from the Fiken URL (fiken.no/foretak/<slug>/...).
FIKEN_API_TOKEN=
FIKEN_COMPANY_SLUG=

# Invoice line settings. Prefer a Fiken product, which carries VAT type and
# income account; otherwise the VAT type and income account below are used.
FIKEN_PRODUCT_ID=
FIKEN_VAT_TYPE=HIGH
FIKEN_INCOME_ACCOUNT=3000
FIKEN_DAYS_UNTIL_DUE=14

# Set to false only for local development over plain http in browsers
# that refuse Secure cookies on localhost.
COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=43200

# Defaults to data/zaptecfaktura.db locally and /data/zaptecfaktura.db in Docker.
# DATABASE_PATH=
